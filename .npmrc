# ---- pnpm 在本项目的两条必要配置 ----

# 1) Windows 普通账户（非管理员）无法创建符号链接。
#    pnpm 默认用「全局存储 + 符号链接」组织 node_modules，会直接安装失败。
#    改成和 npm 一样的扁平目录 + 复制，绕开符号链接。
node-linker=hoisted
package-import-method=copy

# 2) pnpm 10 起默认不执行依赖的安装脚本，安装结束时返回非 0 退出码。
#    本项目只有 esbuild 需要跑安装脚本（Vite 的编译器），放开即可。
#    pnpm-workspace.yaml 里的 onlyBuiltDependencies 在 pnpm 11 下实测未生效，
#    所以用这个总开关。
dangerously-allow-all-builds=true
